# Local development only. Copy to .env; never commit real secrets.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
# Placeholder only. Auth transactions need Atlas or a local replica set.
# For Atlas use your private URI in .env.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=ngc_science_club
# Backend public origin; Better Auth appends /api/auth itself.
BETTER_AUTH_URL=http://localhost:5000
# Required: generate at least 32 random characters in your private .env.
# Intentionally blank: never commit a usable auth secret.
BETTER_AUTH_SECRET=

# Offline first-admin tooling only. Prefer temporary PowerShell process variables.
# Blank defaults do not enable or execute bootstrap during server startup.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EXPECTED_DB=
BOOTSTRAP_ADMIN_USER_ID=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_OWNER_REVIEWER_EMAIL=
BOOTSTRAP_ADMIN_OWNER_REFERENCE=
BOOTSTRAP_ADMIN_OWNER_VERIFIED_AT=
