{
  "name": "ngc-science-club-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "check:production": "node scripts/check-production.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth": "node --import tsx --test --test-concurrency=1 tests/auth-flow.test.mjs tests/auth-security.test.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:serve": "node scripts/test-api.mjs",
    "test:launch:serve": "node scripts/launch-test-api.mjs",
    "test:atlas:auth": "npm run build && node --test --test-concurrency=1 tests/auth.integration.test.mjs",
    "auth:secret": "node scripts/create-auth-secret.mjs",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test:bootstrap": "node --import tsx --test --test-concurrency=1 tests/bootstrap-admin.test.mjs",
    "test:rbac": "node --import tsx --test --test-concurrency=1 tests/rbac.test.mjs",
    "test:security": "node --import tsx --test --test-concurrency=1 tests/auth-security.test.mjs",
    "test:membership": "node --import tsx --test --test-concurrency=1 tests/membership.test.mjs",
    "test:members": "node --import tsx --test --test-concurrency=1 tests/member-directory.test.mjs",
    "test:analytics": "node --import tsx --test --test-concurrency=1 tests/membership-analytics.test.mjs",
    "test:quizzes": "node --import tsx --test --test-concurrency=1 tests/quizzes.test.mjs",
    "test:assessments": "node --import tsx --test --test-concurrency=1 tests/assessments.test.mjs",
    "test:events": "node --import tsx --test --test-concurrency=1 tests/events.test.mjs",
    "test:performance": "node --import tsx --test --test-concurrency=1 tests/performance.test.mjs",
    "test:faculty": "node --import tsx --test --test-concurrency=1 tests/faculty.test.mjs",
    "test:feedback": "node --import tsx --test --test-concurrency=1 tests/feedback.test.mjs",
    "test:communication": "node --import tsx --test --test-concurrency=1 tests/communication.test.mjs",
    "test:resources": "node --import tsx --test --test-concurrency=1 tests/resources.test.mjs",
    "test:showcase": "node --import tsx --test --test-concurrency=1 tests/showcase-certificates.test.mjs",
    "test:reports": "node --import tsx --test --test-concurrency=1 tests/reports.test.mjs"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.18",
    "better-auth": "1.7.18",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "8.3.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "description": "",
  "main": "index.js",
  "keywords": []
}
